#!/bin/bash

#echo "Enter action (start/stop/status):"
#read action
#echo "Enter action:"

PS3="Choose Action:"
select action in start stop status exit
do
        case $action in
                start)
                        systemctl start nginx
                        echo "Nginx started"
                        ;;
                stop) 
                        systemctl stop nginx
                        echo "Nginx Stopped"
                        ;;
                status)
                        systemctl status nginx
                        echo "Nginx Status"
                        ;;
                exit)
                      break
                      ;;
                *)
                        echo "Invalid Input"
                        ;;
        esac
done

