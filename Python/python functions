program 3: (devops script)
def check_server(status):
    if status == "running":
        print ("Server is UP")
    else:
        print("Server is DOWN")

def check_disk(usage) :
    if usage > 80 :
        print("Warning: Disk is full")
    else :
        print("Disk usage is normal")

check_disk(85)
check_disk(70)
check_server("running")
check_server("Stopped")
check_server("Terminated")

